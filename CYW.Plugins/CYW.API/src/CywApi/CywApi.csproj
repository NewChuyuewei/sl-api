<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>0CywApi</AssemblyName>
    <RootNamespace>CywApi</RootNamespace>
    <Version>0.1.0</Version>
    <Title>CYW's API</Title>
    <Authors>CYW</Authors>
    <Description>CYW's API - an extension framework for the LabAPI modding framework (SCP:SL). Independent implementation inspired by LabExtended.</Description>
    <Copyright>Copyright (c) 2026 CYW</Copyright>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>embedded</DebugType>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.AssemblyPublicizer.MSBuild" Version="0.4.3" PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <!-- Lib.Harmony 2.2.2：与目标服务器随附的 0Harmony 版本一致（2026-11-08 实机验证） -->
    <PackageReference Include="Lib.Harmony" Version="2.2.2" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CywApi.Core\CywApi.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- BLD-006: publicized by design — the framework's game-side patch surface for
         [CywPatch] classes, which target game internals that have no public route.
         Verified 2026-11-14: the current code set compiles without publicization; the
         surface is retained deliberately as a declared policy (framework patch surface). -->
    <Reference Include="Assembly-CSharp" Publicize="true">
      <HintPath>$(SL_REFERENCES)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- BLD-006: retained with Assembly-CSharp under the same game patch-surface policy —
         first-pass game code (MEC coroutines, Discord, Unity standard assets). -->
    <Reference Include="Assembly-CSharp-firstpass" Publicize="true">
      <HintPath>$(SL_REFERENCES)\Assembly-CSharp-firstpass.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- BLD-006: intentionally NOT publicized — our code uses only the public LabAPI
         surface (build green with publicization removed, verified 2026-11-14); depending
         on LabAPI internals is explicitly avoided. -->
    <Reference Include="LabApi">
      <HintPath>$(SL_REFERENCES)\LabApi.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="CommandSystem.Core">
      <HintPath>$(SL_REFERENCES)\CommandSystem.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Mirror">
      <HintPath>$(SL_REFERENCES)\Mirror.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- BLD-006: retained with Assembly-CSharp under the same game patch-surface policy —
         shared game infrastructure. -->
    <Reference Include="NorthwoodLib" Publicize="true">
      <HintPath>$(SL_REFERENCES)\NorthwoodLib.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Pooling">
      <HintPath>$(SL_REFERENCES)\Pooling.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(SL_REFERENCES)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(SL_REFERENCES)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
